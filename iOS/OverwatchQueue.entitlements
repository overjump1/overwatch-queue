<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.tomerady.OverwatchQueue</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
	<!-- What actually lets `interruption-level: time-sensitive` mean anything. Asking for
	     `.timeSensitive` in `requestAuthorization` is the deprecated half of this and is
	     not enough on its own: without the entitlement the level is quietly downgraded,
	     and a match-found alert would sit behind a Focus like any other notification. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
